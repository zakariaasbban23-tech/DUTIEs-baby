{
  "name": "dorm-duty",
  "version": "1.0.0",
  "private": true,
  "description": "Free, local-only dorm garbage and floor-cleaning rotations",
  "scripts": {
    "build": "npm run build:h5 && npm run build:weapp && node scripts/prepare-preview.cjs",
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "test": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@tarojs/components": "4.1.7",
    "@tarojs/react": "^4.1.7",
    "@tarojs/runtime": "4.1.7",
    "@tarojs/taro": "4.1.7",
    "react": "18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/preset-react": "^7.25.9",
    "@tarojs/cli": "4.1.7",
    "@tarojs/plugin-framework-react": "^4.1.7",
    "@tarojs/plugin-platform-h5": "4.1.7",
    "@tarojs/plugin-platform-weapp": "4.1.7",
    "@tarojs/webpack5-runner": "4.1.7",
    "@types/react": "18.3.12",
    "babel-preset-taro": "4.1.7",
    "postcss": "8.4.49",
    "sass": "1.82.0",
    "tsx": "4.19.2",
    "typescript": "5.7.2"
  }
}
